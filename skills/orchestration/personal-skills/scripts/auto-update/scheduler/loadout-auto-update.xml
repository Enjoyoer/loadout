<?xml version="1.0" encoding="UTF-16"?>
<!-- INERT TEMPLATE (Task Scheduler), for an idle-gated Windows host. Not registered by any sync. Replace @NODE@,
     @RUNNER@, @HOST@ and @USER@ (DOMAIN\user), save as UTF-16, and register only when Config approves. A periodic
     tick every 10 minutes while the user is logged on (InteractiveToken); it never wakes the host and never catches
     up a missed tick. The runner samples the host idle gates and enforces the Sunday 05:00-07:00 blackout. A
     daily-use PC uses loadout-auto-update-pc.xml instead.
     The task waits for the transaction it starts (the runner's wait flag), so the task's end never cuts a transaction short;
     PT5H is above the 4 h worst case the registry validation allows for a Windows transaction. IgnoreNew skips the
     ticks that fall while it runs. -->
<Task version="1.4" xmlns="http://schemas.microsoft.com/windows/2004/02/mit/task">
  <RegistrationInfo><Description>Loadout fleet auto-update runner</Description></RegistrationInfo>
  <Triggers>
    <CalendarTrigger>
      <StartBoundary>2026-01-04T00:00:00</StartBoundary>
      <Repetition><Interval>PT10M</Interval><Duration>P1D</Duration><StopAtDurationEnd>false</StopAtDurationEnd></Repetition>
      <ScheduleByDay><DaysInterval>1</DaysInterval></ScheduleByDay>
    </CalendarTrigger>
  </Triggers>
  <Principals>
    <Principal id="Author"><UserId>@USER@</UserId><LogonType>InteractiveToken</LogonType><RunLevel>LeastPrivilege</RunLevel></Principal>
  </Principals>
  <Settings>
    <MultipleInstancesPolicy>IgnoreNew</MultipleInstancesPolicy>
    <DisallowStartIfOnBatteries>true</DisallowStartIfOnBatteries>
    <StopIfGoingOnBatteries>false</StopIfGoingOnBatteries>
    <StartWhenAvailable>false</StartWhenAvailable>
    <WakeToRun>false</WakeToRun>
    <RunOnlyIfNetworkAvailable>true</RunOnlyIfNetworkAvailable>
    <ExecutionTimeLimit>PT5H</ExecutionTimeLimit>
    <Priority>7</Priority>
    <Enabled>false</Enabled>
  </Settings>
  <Actions Context="Author">
    <Exec><Command>@NODE@</Command><Arguments>"@RUNNER@" run --host @HOST@ --wait</Arguments></Exec>
  </Actions>
</Task>
