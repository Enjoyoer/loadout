# INERT TEMPLATE (systemd --user). Enable only when Config approves phase 1.
# A periodic tick every 10 minutes; the runner samples the host idle gates and applies at most one change when
# every gate is open. Persistent=false: a missed tick is not caught up; the runner enforces the Sunday
# 05:00-07:00 blackout and every window itself.
[Unit]
Description=Loadout fleet auto-update runner tick

[Timer]
OnCalendar=*:00/10
Persistent=false
AccuracySec=30s
RandomizedDelaySec=0

[Install]
WantedBy=timers.target
