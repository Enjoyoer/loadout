{
  "pi": {
    "root": "~/.local/share/loadout-pi-1.0.0",
    "catalogSources": [
      "claude",
      "codex"
    ],
    "defaultSourceProvider": "codex",
    "runtime": {
      "route": {
        "path": "~/.codex/config.toml",
        "keys": [
          "model_providers",
          "example_router",
          "base_url"
        ]
      },
      "credential": {
        "kind": "toml",
        "path": "~/.codex/config.toml",
        "keys": [
          "model_providers",
          "example_router",
          "http_headers",
          "X-Api-Key"
        ]
      },
      "credentialHeaders": [
        "X-Api-Key"
      ],
      "paseoMcp": {
        "url": "http://127.0.0.1:6767/mcp/agents"
      },
      "directProviders": {
        "local": {
          "baseUrl": "https://gate.example.test/v1",
          "api": "openai-completions",
          "auth": {
            "credential": {
              "kind": "command",
              "argv": [
                "/usr/bin/security",
                "find-generic-password",
                "-s",
                "example-gate",
                "-a",
                "EXAMPLE_GATE_TOKEN",
                "-w"
              ]
            }
          },
          "models": [
            {
              "id": "example-local-27b",
              "name": "Example Local",
              "reasoning": true,
              "input": [
                "text"
              ],
              "contextWindow": 32768,
              "maxTokens": 8192,
              "cost": {
                "input": 0,
                "output": 0,
                "cacheRead": 0,
                "cacheWrite": 0
              },
              "thinkingLevelMap": {
                "off": null,
                "minimal": null,
                "low": "low",
                "medium": "medium",
                "high": "high",
                "xhigh": null,
                "max": null
              }
            }
          ]
        }
      }
    }
  }
}
