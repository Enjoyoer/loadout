{
  "providers": {
    "claude": {
      "models": [
        {
          "id": "example-opus",
          "label": "Opus",
          "description": "Most capable",
          "isDefault": true,
          "thinkingOptions": [
            {
              "id": "low",
              "label": "Low"
            },
            {
              "id": "high",
              "label": "High"
            }
          ]
        },
        {
          "id": "example-sonnet",
          "label": "Sonnet",
          "description": "Fast and cheap",
          "thinkingOptions": [
            {
              "id": "low",
              "label": "Low"
            }
          ]
        }
      ]
    },
    "codex": {
      "models": [
        {
          "id": "example-coder",
          "label": "Astra",
          "description": "Default coding model",
          "thinkingOptions": [
            {
              "id": "medium",
              "label": "medium"
            },
            {
              "id": "high",
              "label": "high"
            }
          ],
          "isDefault": true
        }
      ]
    }
  },
  "env": {
    "claude": {
      "ANTHROPIC_BASE_URL": "https://router.example.test"
    }
  },
  "hosts": {
    "laptop": {
      "env": {
        "claude": {
          "ANTHROPIC_BASE_URL": "http://127.0.0.1:4000"
        }
      }
    },
    "tablet": {
      "inherit_env": false,
      "required_env": {
        "claude": [
          "ANTHROPIC_BASE_URL"
        ]
      }
    }
  }
}
