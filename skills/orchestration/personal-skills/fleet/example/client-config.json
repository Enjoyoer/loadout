{
  "mcpServers": {},
  "codex": {
    "top": { "approval_policy": "on-request", "sandbox_mode": "workspace-write", "model_reasoning_effort": "high" },
    "reportOnly": ["model"]
  },
  "claude": {
    "minVersion": "2.1.0",
    "settings": { "theme": "dark", "permissions": { "defaultMode": "acceptEdits" } },
    "env": { "CLAUDE_CODE_SUBAGENT_MODEL": "example-small" },
    "removeEnv": ["ANTHROPIC_BASE_URL", "ANTHROPIC_AUTH_TOKEN"]
  },
  "roles": {
    "remote": {
      "codex": {
        "removeTop": ["model_provider"],
        "sections": {
          "model_providers.example_router": { "base_url": "https://router.example.test/v1", "wire_api": "responses" }
        }
      }
    }
  },
  "hosts": {
    "desktop": {
      "codex": { "reportOnly": ["model_reasoning_effort"] },
      "claude": { "settings": { "theme": "light" } }
    }
  }
}
