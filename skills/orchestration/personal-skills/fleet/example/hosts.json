{
  "source_host": "laptop",
  "transport": "ssh",
  "hosts": [
    {
      "name": "laptop", "os": "macos", "checkout": "~/src/loadout", "clients": ["codex", "claude"],
      "paseo": { "plugin_root": "~/.local/share/loadout/plugins", "stage": ["merged-worker-archiver"], "install": ["merged-worker-archiver"] }
    },
    {
      "name": "desktop", "os": "windows", "checkout": null, "clients": ["codex", "claude"],
      "paseo": { "plugin_root": "%LOCALAPPDATA%\\loadout\\plugins", "stage": ["merged-worker-archiver", "usage-limit-auto-resume"], "install": [] }
    },
    { "name": "devbox", "os": "linux", "checkout": null, "clients": ["codex"] }
  ],
  "global": {
    "codex": "$CODEX_HOME/AGENTS.md",
    "claude": "~/.claude/CLAUDE.md",
    "opencode": "~/.config/opencode/AGENTS.md"
  }
}
