{
  "name": "orphan-project-sweeper",
  "private": true,
  "version": "0.2.0",
  "description": "Paseo server-only plugin that removes orphaned project rows (no active workspace, path missing on disk).",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.ts",
    "build": "esbuild index.server.ts --bundle --platform=node --format=cjs --target=node20 --outfile=node_modules/.cache/orphan-project-sweeper/index.server.cjs --external:@getpaseo/plugin --external:@getpaseo/plugin/server --external:zod --log-level=warning && echo build ok",
    "dry-run": "node scripts/dry-run.ts",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@getpaseo/client": "0.11.1"
  },
  "devDependencies": {
    "@getpaseo/plugin": "0.11.1",
    "@getpaseo/protocol": "0.11.1",
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3",
    "zod": "^4.4.3"
  }
}
