{
  "name": "usage-limit-auto-resume",
  "private": true,
  "version": "0.1.0",
  "description": "Safely resumes same-agent work after a recognized usage-limit failure.",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.ts",
    "build": "esbuild index.server.ts --bundle --platform=node --format=cjs --target=node20 --outfile=node_modules/.cache/usage-limit-auto-resume/index.server.cjs --external:@getpaseo/plugin --external:@getpaseo/plugin/server --external:zod --log-level=warning && echo build ok",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@getpaseo/client": "0.9.2"
  },
  "devDependencies": {
    "@getpaseo/plugin": "0.9.2",
    "@getpaseo/protocol": "0.9.2",
    "@types/node": "^22.0.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3",
    "zod": "^4.4.3"
  }
}
